# --- Scenic client environment ---
# Copy to `.env.local` for local development. Never commit real values.

# The API base URL, including /api. The name is kept from the Create React App
# days so the existing Vercel setting keeps working. When unset, production
# builds use https://scenic-api.vercel.app/api and `npm run dev` uses
# http://localhost:5000/api.
REACT_APP_BACKEND_URL=http://localhost:5000/api
