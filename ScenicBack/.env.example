# --- Scenic backend environment ---
# Copy this file to `.env` and fill in real values.

# MongoDB connection string (MongoDB Atlas, or a local mongodb:// URI)
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scenic?retryWrites=true&w=majority

# Secret used to sign/verify JWTs — any long, random string
JWT_KEY=change_me_to_a_long_random_secret

# Google Maps Geocoding API key (turns a scene address into coordinates)
GOOGLE_API_KEY=your_google_geocoding_api_key

# Port the API server listens on
PORT=5000

# NOTE: the frontend's REACT_APP_BACKEND_URL must point at this server's
# `/api` path, e.g. http://localhost:5000/api
