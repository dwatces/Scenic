# --- Scenic API environment ---
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# MongoDB connection string (MongoDB Atlas, or a local replica set).
# Leave it unset to run the API in read-only demo mode.
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scenic?retryWrites=true&w=majority

# Secret used to sign and verify JWTs: any long, random string.
JWT_KEY=change_me_to_a_long_random_secret

# Optional Google Geocoding API key. Leave it empty to geocode with
# Nominatim, then Photon (no key needed).
GOOGLE_API_KEY=

# Optional. Port the API listens on locally (defaults to 5000).
PORT=5000

# Optional. Only read by util/seedAtlas.js: the password given to the seeded
# demo accounts. If unset, the seeder generates one and prints it once.
# SEED_PASSWORD=

# The client's REACT_APP_BACKEND_URL must point at this server's `/api`
# path, for example http://localhost:5000/api
